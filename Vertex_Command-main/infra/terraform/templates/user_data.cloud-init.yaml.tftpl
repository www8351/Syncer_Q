#cloud-config
# Provisioned by Terraform. provision.sh is embedded base64 (decoded by cloud-init);
# only ssh_port / ssh_public_key / ecr_registry are templated. $home below is a literal
# shell variable (no braces) and is NOT touched by Terraform's templatefile().
write_files:
  - path: /opt/bootstrap/provision.sh
    owner: root:root
    permissions: '0755'
    encoding: b64
    content: ${provision_b64}
  - path: /opt/bootstrap/setup.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive

      # ECR credential helper -> keyless docker pulls via the instance IAM role.
      apt-get update -qq
      apt-get install -y -qq amazon-ecr-credential-helper

      # OS hardening + Docker Engine/Compose (reuses infra/vps/provision.sh).
      export SSH_PORT="${ssh_port}"
      export SSH_PUBLIC_KEY="${ssh_public_key}"
      /opt/bootstrap/provision.sh

      # Point docker at the ECR registry via the credential helper (root + deploy user).
      for home in /root /home/vertex; do
        install -d -m 700 "$home/.docker"
        printf '{ "credHelpers": { "${ecr_registry}": "ecr-login" } }\n' > "$home/.docker/config.json"
      done
      chown -R vertex:vertex /home/vertex/.docker

runcmd:
  - /opt/bootstrap/setup.sh
